---
import type { CollectionEntry } from 'astro:content';

interface Props {
  brands: CollectionEntry<'marki'>[];
}
const { brands } = Astro.props;
---

{/*
  Brand names as wordmarks, per design/index.html. The 2017 logo PNGs are
  150×150 with no alt text — they are not used until larger or SVG files exist
  (CLAUDE.md §17).
*/}
<div class="logos">
  {brands.map((b) => <a class="logo" href={`/marki/${b.id}/`}>{b.data.brand}</a>)}
</div>

<style>
  .logos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 18px;
    margin-top: 32px;
  }
  .logo {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 32px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--paper);
    min-height: 132px;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 30px;
    color: var(--ink-2);
  }
  .logo:hover {
    border-color: var(--brass);
    background: var(--brass-wash);
    color: var(--ink);
  }
</style>
