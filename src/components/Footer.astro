---
import { site } from '../data/site';
import Logo from './Logo.astro';

interface Props {
  hasSaveti?: boolean;
}
const { hasSaveti = false } = Astro.props;

const nav = [
  { href: '/#povredi', label: 'Повреди' },
  { href: '/#marki', label: 'Марки' },
  { href: '/raioni/', label: 'Райони' },
  { href: '/sushilni/', label: 'Сушилни' },
  { href: '/greshki/', label: 'Грешки' },
  ...(hasSaveti ? [{ href: '/saveti/', label: 'Съвети' }] : []),
  { href: '/poveritelnost/', label: 'Поверителност' },
  { href: '/biskvitki/', label: 'Бисквитки' },
];
// build-time year: the old site's footer was stuck on 2017
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="fbrand">
      <Logo tone="dark" size={44} />
      <div class="fname">Ремонт перални<br />София</div>
    </div>
    <p class="line">
      {site.tagline} · София и околностите ·
      <a href={site.phoneHref}>{site.phone}</a>
    </p>
    <nav class="fnav" aria-label="Долна навигация">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    <p class="copy">© {year} {site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--on-dark-mute);
    padding: 48px 0;
    font-size: 14px;
  }
  .site-footer a {
    color: var(--on-dark);
  }
  .site-footer a:hover {
    color: #fff;
  }
  .fbrand {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .fname {
    font-family: var(--font-display);
    font-size: 18px;
    color: #fff;
    text-transform: uppercase;
    line-height: 1.1;
  }
  .line {
    margin-top: 16px;
  }
  .fnav {
    display: flex;
    flex-wrap: wrap;
    column-gap: 20px;
    margin-top: 8px;
  }
  .fnav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .copy {
    margin-top: 14px;
    font-size: 14px;
  }
</style>
