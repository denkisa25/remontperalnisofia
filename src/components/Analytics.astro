---
/**
 * GA4 and Google Tag Manager with Google Consent Mode v2 ("advanced" mode).
 *
 * On every page, BEFORE the GA4 tag or the GTM container is loaded, consent is set to
 *   ad_storage, analytics_storage, ad_user_data, ad_personalization = denied
 * "Приемам" updates all four to granted; "Отказвам" leaves them denied. The
 * choice is kept in localStorage (`rps-consent`) and replayed as
 * default(denied) -> update(granted) on later visits, still before anything loads.
 *
 * While denied, the tag sends cookieless pings and stores nothing on the device.
 * The privacy and cookie pages describe exactly this — keep them in sync.
 *
 * Every tel: click sends the conversion event (site.analytics.telConversionEvent)
 * in either state; Google applies the current consent state to it.
 *
 * GTM: Google's own tags inside the container honour these signals; third-party
 * tags need "additional consent checks" set in the container itself.
 *
 * When site.analytics.ga4 and .gtm are both empty no banner is rendered and nothing is ever
 * requested from Google (the bundled script finds no #consent element).
 */
import { site } from '../data/site';
const { ga4, gtm, telConversionEvent } = site.analytics;
---

{
  (ga4 || gtm) && (
    <div id="consent" data-ga4={ga4} data-gtm={gtm} data-event={telConversionEvent}>
      <section class="banner" aria-label="Бисквитки" hidden>
        <p>
          Използваме Google Analytics и измерване на рекламите на Google, за да видим кои страници
          помагат и колко обаждания идват от сайта. Ако откажете, не се записват бисквитки.
          <a href="/biskvitki/">Подробности</a>
        </p>
        <div class="actions">
          <button type="button" class="btn btn-dark" data-consent="denied">Отказвам</button>
          <button type="button" class="btn btn-dark" data-consent="granted">Приемам</button>
        </div>
      </section>
    </div>
  )
}

<style>
  .banner {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: 88px; /* above the mobile call bar */
    z-index: 80;
    max-width: 640px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-top: 3px solid var(--brass);
    border-radius: var(--radius);
    padding: 18px 20px;
    box-shadow: 0 8px 30px rgba(21, 24, 28, 0.18);
  }
  .banner[hidden] {
    display: none;
  }
  p {
    font-size: 15px;
    color: var(--ink-2);
  }
  .actions {
    display: flex;
    gap: 10px;
    margin-top: 14px;
  }
  .actions .btn {
    flex: 1;
    font-size: 15px;
    padding: 12px 16px;
    min-height: 48px;
  }
  @media (min-width: 860px) {
    .banner {
      bottom: 20px;
      left: 20px;
    }
  }
</style>

<script>
  const root = document.getElementById('consent');
  if (root) {
    const id = root.dataset.ga4 as string; // may be ''
    const gtmId = root.dataset.gtm as string; // may be ''
    const eventName = root.dataset.event as string;
    const KEY = 'rps-consent';
    const w = window as unknown as {
      dataLayer: unknown[];
      gtag: (...a: unknown[]) => void;
    };
    const SIGNALS = ['ad_storage', 'analytics_storage', 'ad_user_data', 'ad_personalization'];
    const state = (v: 'granted' | 'denied') => Object.fromEntries(SIGNALS.map((k) => [k, v]));

    const read = () => {
      try {
        return localStorage.getItem(KEY);
      } catch {
        return null;
      }
    };
    const write = (v: string | null) => {
      try {
        if (v === null) localStorage.removeItem(KEY);
        else localStorage.setItem(KEY, v);
      } catch {
        /* private mode: the choice just will not persist */
      }
    };

    // 1. dataLayer + gtag, then consent DEFAULT = denied — before anything else
    w.dataLayer = w.dataLayer || [];
    // gtag.js requires the real `arguments` object, not an array
    w.gtag = function () {
      // eslint-disable-next-line prefer-rest-params
      w.dataLayer.push(arguments);
    };
    w.gtag('consent', 'default', state('denied'));

    // 2. returning visitor who already accepted: update straight away, still before the tag loads
    const choice = read();
    if (choice === 'granted') w.gtag('consent', 'update', state('granted'));

    // 3. only now load Google's tags
    w.gtag('js', new Date());
    if (id) {
      w.gtag('config', id);
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(id);
      document.head.appendChild(s);
    }
    if (gtmId) {
      // standard GTM bootstrap (gtm.start event, then the container)
      w.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      const g = document.createElement('script');
      g.async = true;
      g.src = 'https://www.googletagmanager.com/gtm.js?id=' + encodeURIComponent(gtmId);
      document.head.appendChild(g);
    }

    // every tel: link, any page, one listener — fires in either consent state
    document.addEventListener('click', (e) => {
      const a = (e.target as Element | null)?.closest?.('a[href^="tel:"]');
      if (!a) return;
      w.gtag('event', eventName, {
        link_url: a.getAttribute('href'),
        page_path: location.pathname,
        transport_type: 'beacon',
      });
    });

    const banner = root.querySelector<HTMLElement>('.banner')!;
    if (choice === null) banner.hidden = false;

    banner.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLElement>('[data-consent]');
      if (!b) return;
      const v = b.dataset.consent === 'granted' ? 'granted' : 'denied';
      write(v);
      banner.hidden = true;
      w.gtag('consent', 'update', state(v));
    });

    // "change my choice" button on /biskvitki/
    document.querySelectorAll<HTMLElement>('[data-consent-reset]').forEach((btn) => {
      btn.addEventListener('click', () => {
        write(null);
        // best-effort removal of Google cookies (_ga, _ga_<id>, _gcl_*) on this host and its parent
        const host = location.hostname.split('.').slice(-2).join('.');
        document.cookie.split(';').forEach((c) => {
          const n = c.split('=')[0].trim();
          if (n.startsWith('_ga') || n.startsWith('_gcl')) {
            for (const d of [location.hostname, '.' + host]) {
              document.cookie = `${n}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/; domain=${d}`;
            }
          }
        });
        location.reload();
      });
    });
  }
</script>
